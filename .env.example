# ===========================================
# The Lenny Growth Assistant - Configuration
# ===========================================

# REQUIRED: Choose your LLM provider
MODEL_PROVIDER=anthropic  # Options: anthropic, ollama, openai

# REQUIRED: Add your API key (for Anthropic or OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
MODEL_NAME=claude-3-5-sonnet-20241022
# For OpenAI: MODEL_NAME=gpt-4
# For Ollama: MODEL_NAME=llama2 (and install ollama locally)

# Ollama Configuration (if using local LLM)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama2
# To use Ollama: brew install ollama && ollama pull llama2

# Embedding Configuration
EMBEDDING_PROVIDER=local  # Options: local, openai
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Database Configuration (for Docker)
POSTGRES_USER=lenny_user
POSTGRES_PASSWORD=lenny_password
POSTGRES_DB=lenny_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lenny_user:lenny_password@postgres:5432/lenny_assistant

# API Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# Retrieval Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Agent Configuration
TEMPERATURE=0.7
MAX_TOKENS=2000
MAX_CONTEXT_MESSAGES=10

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# Quick Start Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your ANTHROPIC_API_KEY
# 3. Run: ./scripts/init.sh
# ===========================================

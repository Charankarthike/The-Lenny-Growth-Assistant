# Application Configuration
APP_NAME="Lenny Growth Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=True

# Server Configuration
HOST="0.0.0.0"
PORT=8000
WORKERS=1

# Database Configuration
DATABASE_URL="postgresql://lenny_user:lenny_password@localhost:5432/lenny_assistant"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# LLM Provider Configuration
# Options: "anthropic", "openai", "ollama"
LLM_PROVIDER="ollama"

# Anthropic Configuration (if using Claude)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# OpenAI Configuration (if using GPT)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Ollama Configuration (local models)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
# Other options: "mistral:7b", "phi3:medium"

# Embedding Configuration
EMBEDDING_PROVIDER="local"  # "local" or "openai"
LOCAL_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384  # 384 for MiniLM, 1536 for OpenAI ada-002

# Retrieval Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.7
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Agent Configuration
AGENT_MAX_CONTEXT_MESSAGES=10
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=2000

# Ship 30 for 30 Configuration
SHIP30_MIN_WORDS=1200
SHIP30_MAX_WORDS=1300
SHIP30_MAX_GENERATION_TIME=30  # seconds

# Security
SECRET_KEY="your-secret-key-change-this-in-production"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"  # "json" or "console"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
ENABLE_STREAMING=True
ENABLE_ARTIFACT_GENERATION=True
ENABLE_FALLBACK_PROVIDER=True

# Transcript Data Path
TRANSCRIPT_DATA_PATH="./data/transcripts"
